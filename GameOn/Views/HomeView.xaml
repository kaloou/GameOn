<UserControl x:Class="GameOn.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameOn.Views"
             xmlns:vm="clr-namespace:GameOn.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">


    <Grid Margin="130,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- GAUCHE : présentation + boutons -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Background="#1A2A3A">
            <TextBlock Text="Un défi par jour. Un seul classement." Foreground="White"
                       FontSize="36" FontWeight="Bold" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Margin="0,15">
                <!-- TEMP -->
                <Button Content="Voir les jeux →" Command="{Binding VoirJeuxCommande}"
                        Background="#F5B83D" Padding="15,8" Margin="0,0,10,0"/>
                <!-- TEMP -->
                <Button Content="Consulter le leaderboard" Command="{Binding ClassementCommande}"
                        Padding="15,8"/>
            </StackPanel>
        </StackPanel>

        <!-- DROITE : carte Sudoku du jour -->
        <Border Grid.Row="0" Grid.Column="2" Background="#1A2A3A" CornerRadius="8" Padding="15" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="Sudoku du jour" Foreground="White" FontWeight="Bold" FontSize="16"/>

                <!-- TEMP -->
                <Button Content="Jouer" Command="{Binding JouerCommande}"
                        Background="#F5B83D" Padding="8" Margin="0,120,0,0"/>
            </StackPanel>
        </Border>

        <!-- BAS : top de la semaine -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#1A2A3A" CornerRadius="8" Padding="15" Margin="0,30,0,0" Grid.RowSpan="2">
            <Grid>
                <TextBlock Text="Top de la semaine" Foreground="White" FontWeight="Bold" FontSize="16"
                           VerticalAlignment="Top"/>
                <!-- TEMP -->
                <Button Content="Tout voir" Command="{Binding ClassementCommande}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" Foreground="#C8D2DC" BorderThickness="0"/>

            </Grid>
        </Border>
    </Grid>
</UserControl>
