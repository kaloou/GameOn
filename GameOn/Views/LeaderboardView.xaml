<UserControl x:Class="GameOn.Views.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameOn.Views"
             xmlns:vm="clr-namespace:GameOn.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LeaderboardViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="1153" d:DesignWidth="1440"
             Background="#0E202C"
             UseLayoutRounding="True">

    <!-- Mesures relevées sur la maquette (page Leaderboard, 1440 px de large) : 1 px maquette = 1 px WPF -->
    <UserControl.Resources>
        <FontFamily x:Key="Police">Archivo, Segoe UI</FontFamily>
        <FontFamily x:Key="PoliceTitre">Archivo Expanded, Archivo, Segoe UI</FontFamily>

        <!-- ===== Liste déroulante (ComboBox) ===== -->
        <Style x:Key="ElementListe" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#A9BACA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Fond" Background="Transparent" CornerRadius="6" Padding="11,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#F6FDFF"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Fond" Property="Background" Value="#213447"/>
                                <Setter Property="Foreground" Value="#F6FDFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Liste" TargetType="ComboBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontFamily" Value="{StaticResource Police}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F6FDFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ElementListe}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Toute la boîte ouvre la liste -->
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Fond" Background="#182939" BorderBrush="#283949" BorderThickness="1" CornerRadius="10">
                                            <Path Data="M0.83,0.83 L4.33,4.5 L7.83,0.83" Stroke="#A6B7C7" StrokeThickness="1.67"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="8.67" Height="5.33" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Fond" Property="BorderBrush" Value="#3A4F62"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Fond" Property="BorderBrush" Value="#3A4F62"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"
                                              IsHitTestVisible="False"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" VerticalOffset="6"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#182939" BorderBrush="#283949" BorderThickness="1" CornerRadius="10" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Boutons segmentés (ListBox à sélection unique) ===== -->
        <Style x:Key="Segment" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A9BACA"/>
            <Setter Property="FontFamily" Value="{StaticResource Police}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#DCE6EF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2B4156"/>
                    <Setter Property="Foreground" Value="#F8FDFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Difficulté : une couleur par niveau quand il est sélectionné -->
        <Style x:Key="SegmentDifficulte" TargetType="ListBoxItem" BasedOn="{StaticResource Segment}">
            <Style.Triggers>
                <!-- ponytail: Easy sélectionné n'apparaît pas sur la maquette, vert choisi pour suivre la logique des couleurs -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding}" Value="Easy"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#2C4A40"/>
                    <Setter Property="Foreground" Value="#7DD3A0"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding}" Value="Normal"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#2B4156"/>
                    <Setter Property="Foreground" Value="#8CC2F2"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding}" Value="Hard"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#463B43"/>
                    <Setter Property="Foreground" Value="#F99A97"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Segments" TargetType="ListBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource Segment}"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="#182939" BorderBrush="#283949" BorderThickness="1" CornerRadius="10" Padding="2,4">
                            <ItemsPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Bouton Hall of Fame (doré, grisé quand désactivé) ===== -->
        <Style x:Key="BoutonHallOfFame" TargetType="Button">
            <Setter Property="Width" Value="136"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#212B2D"/>
            <Setter Property="BorderBrush" Value="#574D2E"/>
            <Setter Property="Foreground" Value="#FCC465"/>
            <Setter Property="FontFamily" Value="{StaticResource Police}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fond" Property="BorderBrush" Value="#8A7238"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- En-têtes de colonnes du tableau -->
        <Style x:Key="EnteteColonne" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Police}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A5B8C9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="936" HorizontalAlignment="Center" Margin="0,0,0,89">

            <!-- ===== En-tête ===== -->
            <Grid Height="150">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,55,0,0">
                    <TextBlock Text="Leaderboard" FontFamily="{StaticResource PoliceTitre}" FontSize="44" FontWeight="ExtraBold"
                               Foreground="#EBF5FF"/>

                    <!-- Badge "Données d'exemple" (bordure pointillée) -->
                    <Grid Width="127" Height="26" Margin="13,11,0,0" VerticalAlignment="Top">
                        <Rectangle Stroke="#3A4F62" StrokeThickness="1" StrokeDashArray="3 2" RadiusX="6" RadiusY="6"/>
                        <TextBlock Text="Données d'exemple" FontFamily="{StaticResource Police}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#A6B9C8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <TextBlock Text="{Binding SousTitre}" FontFamily="{StaticResource Police}" FontSize="16"
                           Foreground="#A9BBC9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,109,0,0"/>

                <!-- Pas encore de page Hall of Fame : bouton désactivé (grisé) -->
                <Button Style="{StaticResource BoutonHallOfFame}" IsEnabled="False"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,0,0"
                        ToolTip="Bientôt disponible" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M5,16 L3,5 L8.5,10 L12,4 L15.5,10 L21,5 L19,16 Z M5,18 H19 V19 C19,19.6 18.6,20 18,20 H6 C5.4,20 5,19.6 5,19 Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Fill" Width="12" Height="11.67" VerticalAlignment="Center"/>
                        <TextBlock Text="Hall of Fame" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ===== Filtres ===== -->
            <StackPanel Orientation="Horizontal" Height="50">
                <ComboBox Style="{StaticResource Liste}" Width="194" Margin="0,0,12,0"
                          ItemsSource="{Binding Jeux}" SelectedItem="{Binding Jeu}"/>
                <ComboBox Style="{StaticResource Liste}" Width="207" Margin="0,0,13,0"
                          ItemsSource="{Binding Departements}" SelectedItem="{Binding Departement}"/>
                <ListBox Style="{StaticResource Segments}" ItemContainerStyle="{StaticResource SegmentDifficulte}"
                         ItemsSource="{Binding Difficultes}" SelectedItem="{Binding Difficulte}"/>
            </StackPanel>

            <ListBox Style="{StaticResource Segments}" Margin="0,12,0,0"
                     ItemsSource="{Binding PeriodesAffichees}" SelectedItem="{Binding Periode}"/>

            <!-- ===== Tableau ===== -->
            <Border Margin="0,24,0,0" Background="#192A3A" BorderBrush="#283949" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <Border Height="44" Background="#15263A" CornerRadius="11,11,0,0">
                        <Grid>
                            <TextBlock Text="RANG" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                            <TextBlock Text="JOUEUR" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Left" Margin="92,0,0,0"/>
                            <TextBlock Text="MEILLEUR" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Right" Margin="0,0,125,0"/>
                            <TextBlock Text="PTS" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Lignes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#233648" BorderThickness="0,1,0,0">
                                    <Grid Height="60">
                                        <!-- Rang : pastille or / argent / bronze pour le podium -->
                                        <Border x:Name="Pastille" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <TextBlock x:Name="Rang" Text="{Binding Rang}" FontFamily="{StaticResource Police}" FontSize="14.5"
                                                       FontWeight="Bold" Foreground="#A5B8C7"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Avatar : couleur selon le département -->
                                        <Border x:Name="Avatar" Width="36" Height="36" CornerRadius="18" Background="#2D4F6B"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="92,0,0,0">
                                            <TextBlock Text="{Binding Initiales}" FontFamily="{StaticResource Police}" FontSize="14"
                                                       FontWeight="Bold" Foreground="#F2FBFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="{Binding Nom}" FontFamily="{StaticResource Police}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#F5FAFE" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,14,0,0"/>
                                        <TextBlock Text="{Binding Departement}" FontFamily="{StaticResource Police}" FontSize="12"
                                                   Foreground="#A7B8CA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,32,0,0"/>

                                        <TextBlock Text="{Binding Meilleur}" FontFamily="{StaticResource Police}" FontSize="15"
                                                   Foreground="#CDDEF0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,124,0"/>
                                        <TextBlock Text="{Binding Points}" FontFamily="{StaticResource Police}" FontSize="17" FontWeight="Bold"
                                                   Foreground="#F5FAFE" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,21,20,0"/>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Rang}" Value="1">
                                        <Setter TargetName="Pastille" Property="Background" Value="#F5B73C"/>
                                        <Setter TargetName="Rang" Property="Foreground" Value="#0B1A1F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rang}" Value="2">
                                        <Setter TargetName="Pastille" Property="Background" Value="#C3D0D9"/>
                                        <Setter TargetName="Rang" Property="Foreground" Value="#0B1A1F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rang}" Value="3">
                                        <Setter TargetName="Pastille" Property="Background" Value="#D79A6E"/>
                                        <Setter TargetName="Rang" Property="Foreground" Value="#0B1A1F"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Departement}" Value="Assurance qualité">
                                        <Setter TargetName="Avatar" Property="Background" Value="#44486E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Departement}" Value="Analyse d'affaires">
                                        <Setter TargetName="Avatar" Property="Background" Value="#2F5A56"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Departement}" Value="Gestion de projet">
                                        <Setter TargetName="Avatar" Property="Background" Value="#5F4D33"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Departement}" Value="Analyse d'applications">
                                        <Setter TargetName="Avatar" Property="Background" Value="#56446A"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
