<UserControl x:Class="GameOn.Views.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameOn.Views"
             xmlns:vm="clr-namespace:GameOn.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:LeaderboardViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="1153" d:DesignWidth="1440"
             Background="#0E202C"
             UseLayoutRounding="True">

    <!-- Mesures relevées sur la maquette (page Leaderboard, 1440 px de large) : 1 px maquette = 1 px WPF -->
    <UserControl.Resources>
        <FontFamily x:Key="Police">Archivo, Segoe UI</FontFamily>
        <FontFamily x:Key="PoliceTitre">Archivo Expanded, Archivo, Segoe UI</FontFamily>

        <!-- Liste déroulante (visuel seulement) -->
        <Style x:Key="Liste" TargetType="Border">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#182939"/>
            <Setter Property="BorderBrush" Value="#283949"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style x:Key="TexteListe" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Police}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F6FDFF"/>
            <Setter Property="Margin" Value="14,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Chevron" TargetType="Path">
            <Setter Property="Data" Value="M0.83,0.83 L4.33,4.5 L7.83,0.83"/>
            <Setter Property="Stroke" Value="#A6B7C7"/>
            <Setter Property="StrokeThickness" Value="1.67"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="8.67"/>
            <Setter Property="Height" Value="5.33"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
        </Style>

        <!-- Groupe de boutons segmentés (visuel seulement) -->
        <Style x:Key="Segments" TargetType="Border">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="#182939"/>
            <Setter Property="BorderBrush" Value="#283949"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="4"/>
        </Style>
        <Style x:Key="Segment" TargetType="Border">
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="TexteSegment" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Police}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A9BACA"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- En-têtes de colonnes du tableau -->
        <Style x:Key="EnteteColonne" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Police}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#A5B8C9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="936" HorizontalAlignment="Center" Margin="0,0,0,89">

            <!-- ===== En-tête ===== -->
            <Grid Height="150">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,55,0,0">
                    <TextBlock Text="Leaderboard" FontFamily="{StaticResource PoliceTitre}" FontSize="44" FontWeight="ExtraBold"
                               Foreground="#EBF5FF"/>

                    <!-- Badge "Données d'exemple" (bordure pointillée) -->
                    <Grid Width="127" Height="26" Margin="13,11,0,0" VerticalAlignment="Top">
                        <Rectangle Stroke="#3A4F62" StrokeThickness="1" StrokeDashArray="3 2" RadiusX="6" RadiusY="6"/>
                        <TextBlock Text="Données d'exemple" FontFamily="{StaticResource Police}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#A6B9C8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <TextBlock Text="Sudoku · Hard · la semaine dernière" FontFamily="{StaticResource Police}" FontSize="16"
                           Foreground="#A9BBC9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,109,0,0"/>

                <!-- Bouton Hall of Fame -->
                <!-- ponytail: pas encore de page Hall of Fame sur main, le bouton n'a pas de commande -->
                <Border Width="136" Height="46" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,80,0,0"
                        Background="#212B2D" BorderBrush="#574D2E" BorderThickness="1" CornerRadius="10" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Path Data="M5,16 L3,5 L8.5,10 L12,4 L15.5,10 L21,5 L19,16 Z M5,18 H19 V19 C19,19.6 18.6,20 18,20 H6 C5.4,20 5,19.6 5,19 Z"
                              Fill="#FCC465" Stretch="Fill" Width="12" Height="11.67" VerticalAlignment="Center"/>
                        <TextBlock Text="Hall of Fame" FontFamily="{StaticResource Police}" FontSize="15" FontWeight="Bold"
                                   Foreground="#FCC465" Margin="11,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Filtres (visuels, pas encore reliés) ===== -->
            <StackPanel Orientation="Horizontal" Height="50">
                <Border Style="{StaticResource Liste}" Width="194" Margin="0,0,12,0">
                    <Grid>
                        <TextBlock Text="Sudoku" Style="{StaticResource TexteListe}"/>
                        <Path Style="{StaticResource Chevron}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Liste}" Width="207" Margin="0,0,13,0">
                    <Grid>
                        <TextBlock Text="Tous les départements" Style="{StaticResource TexteListe}"/>
                        <Path Style="{StaticResource Chevron}"/>
                    </Grid>
                </Border>
                <Border Style="{StaticResource Segments}" Width="213">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Segment}" Width="60">
                            <TextBlock Text="Easy" Style="{StaticResource TexteSegment}"/>
                        </Border>
                        <Border Style="{StaticResource Segment}" Width="74" Margin="4,0">
                            <TextBlock Text="Normal" Style="{StaticResource TexteSegment}"/>
                        </Border>
                        <Border Style="{StaticResource Segment}" Width="61" Background="#463B43">
                            <TextBlock Text="Hard" Style="{StaticResource TexteSegment}" Foreground="#F99A97"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Style="{StaticResource Segments}" Width="350" HorizontalAlignment="Left" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource Segment}" Width="67">
                        <TextBlock Text="Today" Style="{StaticResource TexteSegment}"/>
                    </Border>
                    <Border Style="{StaticResource Segment}" Width="93" Margin="4,0">
                        <TextBlock Text="This week" Style="{StaticResource TexteSegment}"/>
                    </Border>
                    <Border Style="{StaticResource Segment}" Width="92" Background="#2B4156">
                        <TextBlock Text="Last week" Style="{StaticResource TexteSegment}" Foreground="#F8FDFF"/>
                    </Border>
                    <Border Style="{StaticResource Segment}" Width="76" Margin="4,0,0,0">
                        <TextBlock Text="All time" Style="{StaticResource TexteSegment}"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Tableau ===== -->
            <Border Margin="0,24,0,0" Background="#192A3A" BorderBrush="#283949" BorderThickness="1" CornerRadius="12">
                <StackPanel>
                    <Border Height="44" Background="#15263A" CornerRadius="11,11,0,0">
                        <Grid>
                            <TextBlock Text="RANG" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                            <TextBlock Text="JOUEUR" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Left" Margin="92,0,0,0"/>
                            <TextBlock Text="MEILLEUR" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Right" Margin="0,0,125,0"/>
                            <TextBlock Text="PTS" Style="{StaticResource EnteteColonne}" HorizontalAlignment="Right" Margin="0,0,20,0"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Lignes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#233648" BorderThickness="0,1,0,0">
                                    <Grid Height="60">
                                        <!-- Rang : pastille or / argent / bronze pour le podium -->
                                        <Border x:Name="Pastille" Width="30" Height="30" CornerRadius="15" Background="Transparent"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0">
                                            <TextBlock x:Name="Rang" Text="{Binding Rang}" FontFamily="{StaticResource Police}" FontSize="14.5"
                                                       FontWeight="Bold" Foreground="#A5B8C7"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Avatar : couleur selon le département -->
                                        <Border x:Name="Avatar" Width="36" Height="36" CornerRadius="18" Background="#2D4F6B"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="92,0,0,0">
                                            <TextBlock Text="{Binding Initiales}" FontFamily="{StaticResource Police}" FontSize="14"
                                                       FontWeight="Bold" Foreground="#F2FBFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Text="{Binding Nom}" FontFamily="{StaticResource Police}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#F5FAFE" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,14,0,0"/>
                                        <TextBlock Text="{Binding Departement}" FontFamily="{StaticResource Police}" FontSize="12"
                                                   Foreground="#A7B8CA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="141,32,0,0"/>

                                        <TextBlock Text="{Binding Meilleur}" FontFamily="{StaticResource Police}" FontSize="15"
                                                   Foreground="#CDDEF0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,124,0"/>
                                        <TextBlock Text="{Binding Points}" FontFamily="{StaticResource Police}" FontSize="17" FontWeight="Bold"
                                                   Foreground="#F5FAFE" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,21,20,0"/>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Rang}" Value="1">
                                        <Setter TargetName="Pastille" Property="Background" Value="#F5B73C"/>
                                        <Setter TargetName="Rang" Property="Foreground" Value="#0B1A1F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rang}" Value="2">
                                        <Setter TargetName="Pastille" Property="Background" Value="#C3D0D9"/>
                                        <Setter TargetName="Rang" Property="Foreground" Value="#0B1A1F"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Rang}" Value="3">
                                        <Setter TargetName="Pastille" Property="Background" Value="#D79A6E"/>
                                        <Setter TargetName="Rang" Property="Foreground" Value="#0B1A1F"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Departement}" Value="Assurance qualité">
                                        <Setter TargetName="Avatar" Property="Background" Value="#44486E"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Departement}" Value="Analyse d'affaires">
                                        <Setter TargetName="Avatar" Property="Background" Value="#2F5A56"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Departement}" Value="Gestion de projet">
                                        <Setter TargetName="Avatar" Property="Background" Value="#5F4D33"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Departement}" Value="Analyse d'applications">
                                        <Setter TargetName="Avatar" Property="Background" Value="#56446A"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
