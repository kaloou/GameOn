<Window x:Class="GameOn.Views.DifficultyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameOn.Views"
        mc:Ignorable="d"
        Title="DifficultyWindow"
        Height="230"
        Width="300"
        Background="#0F1E2B"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <Style x:Key="DifficultyButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="25">
        <TextBlock Text="Choisissez la difficulté :"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <ComboBox x:Name="DifficultyComboBox"
                  SelectedIndex="0"
                  Height="40"
                  FontSize="15"
                  Foreground="Black"
                  BorderBrush="#1F3142"
                  Margin="0,0,0,25">
            <ComboBoxItem Content="Entrainement" Tag="CASUAL"/>
            <ComboBoxItem Content="Facile" Tag="EASY"/>
            <ComboBoxItem Content="Moyen" Tag="MEDIUM"/>
            <ComboBoxItem Content="Difficile" Tag="HARD"/>
        </ComboBox>
 
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button Content="Annuler"
                    Style="{StaticResource DifficultyButtonStyle}"
                    IsCancel="True"/>
            
            <Button x:Name="Play_Button"
                    Content="Jouer"
                    Click="Play_Button_Click"
                    Style="{StaticResource DifficultyButtonStyle}"
                    Background="Goldenrod"
                    Foreground="#0F1E2B"
                    IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
