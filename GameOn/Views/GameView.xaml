<UserControl x:Class="GameOn.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:GameOn.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:GameViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="CarteJeu" TargetType="Border">
            <Setter Property="Width" Value="380"/>
            <Setter Property="Height" Value="380"/>
            <Setter Property="Margin" Value="0,0,20,20"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#1F3142"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Border x:Key="BadgeAVenir" x:Shared="False"
                Background="#CC1A2A3A" CornerRadius="14" Padding="12,5"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="White"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="À venir" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
            </StackPanel>
        </Border>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="35,40">
            <TextBlock Text="Games" Foreground="White" FontSize="40" FontWeight="Bold" Margin="0,0,0,25"/>

            <WrapPanel>

                <Border Style="{StaticResource CarteJeu}" Cursor="Hand">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/images/SudokuBanner.png" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding JouerCommande}"/>
                    </Border.InputBindings>

                    <Border VerticalAlignment="Bottom" Background="#E60F1E2B"
                            CornerRadius="0,0,12,12" Padding="16,12">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TempsRestant}"
                                           Foreground="White" FontWeight="Bold" FontSize="16"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#C8D2DC"
                                               FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Défi du jour" Foreground="#C8D2DC" FontSize="13"/>
                                </StackPanel>
                            </DockPanel>
                            <ProgressBar Value="{Binding ProgressionJour, Mode=OneWay}" Maximum="1" Height="4"
                                         Margin="0,10,0,0" Foreground="#F5B83D" Background="#1F3142" BorderThickness="0"/>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- BATTLE ROBOT : à venir, couleurs atténuées comme sur la maquette -->
                <Border Style="{StaticResource CarteJeu}">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/images/BattleRobotBanner.png" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Grid>
                        <!-- calque noir et blanc à moitié transparent : désature sans tout griser -->
                        <Border CornerRadius="11" Opacity="0.5">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <FormatConvertedBitmap DestinationFormat="Gray8">
                                            <FormatConvertedBitmap.Source>
                                                <BitmapImage UriSource="/Assets/images/BattleRobotBanner.png"/>
                                            </FormatConvertedBitmap.Source>
                                        </FormatConvertedBitmap>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Border.Background>
                        </Border>
                        <!-- léger assombrissement -->
                        <Border CornerRadius="11" Background="#330F1E2B"/>
                        <ContentControl Content="{StaticResource BadgeAVenir}"/>
                    </Grid>
                </Border>

                <!-- GTA : à venir, couleurs atténuées comme sur la maquette -->
                <Border Style="{StaticResource CarteJeu}">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/images/GTA6Banner.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                    <Grid>
                        <!-- calque noir et blanc à moitié transparent : désature sans tout griser -->
                        <Border CornerRadius="11" Opacity="0.5">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill">
                                    <ImageBrush.ImageSource>
                                        <FormatConvertedBitmap DestinationFormat="Gray8">
                                            <FormatConvertedBitmap.Source>
                                                <BitmapImage UriSource="/Assets/images/GTA6Banner.jpg"/>
                                            </FormatConvertedBitmap.Source>
                                        </FormatConvertedBitmap>
                                    </ImageBrush.ImageSource>
                                </ImageBrush>
                            </Border.Background>
                        </Border>
                        <!-- léger assombrissement -->
                        <Border CornerRadius="11" Background="#330F1E2B"/>
                        <ContentControl Content="{StaticResource BadgeAVenir}"/>
                    </Grid>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
